{
  "name": "vertex-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "schema:deploy": "sanity schema deploy",
    "typegen": "sanity schemas extract --force && sanity typegen generate",
    "seed:transform": "node scripts/seed/transform.mjs \"${TMPDIR:-/tmp}/vertex-seed.import.ndjson\"",
    "seed:covers": "node scripts/seed/covers.mjs",
    "seed": "npm run seed:transform && npm run seed:import",
    "seed:import": "set -a && . ./.env.local && set +a && sanity dataset import --replace \"${TMPDIR:-/tmp}/vertex-seed.import.ndjson\" --dataset \"$SANITY_STUDIO_DATASET\"",
    "videos:ingest": "set -a && . ./.env.local && set +a && node scripts/videos/ingest.mjs \"${TMPDIR:-/tmp}/vertex-videos.ndjson\"",
    "videos:import": "set -a && . ./.env.local && set +a && sanity dataset import --replace \"${TMPDIR:-/tmp}/vertex-videos.ndjson\" --dataset \"$SANITY_STUDIO_DATASET\"",
    "videos": "npm run videos:ingest && npm run videos:import"
  },
  "dependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/icons": "^3.8.0",
    "@sanity/vision": "^6.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.18.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
