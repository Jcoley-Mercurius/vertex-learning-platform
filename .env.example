# Canonical list of the environment variables this app reads.
# Copy to .env.local and fill in. Never commit real values.
#
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server only.

# --- Sanity -----------------------------------------------------------------
# Safe to expose. Find both in https://www.sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional. Pins the API version; defaults to the date the project was scaffolded.
NEXT_PUBLIC_SANITY_API_VERSION=

# SERVER ONLY. The dataset is private, so every read needs this.
# Sanity Manage -> API -> Tokens -> Add token, with Viewer permissions.
SANITY_API_READ_TOKEN=

# SERVER ONLY. Learner progress is the only thing the app writes, and it is
# written only inside /api/progress. Sanity Manage -> API -> Tokens, Editor.
# SERVER ONLY. Progress writes (lesson completion, resume position) need this.
# Sanity Manage -> API -> Tokens -> Add token, with Editor permissions.
SANITY_API_WRITE_TOKEN=

# --- Clerk ------------------------------------------------------------------
# Safe to expose.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SERVER ONLY.
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- PostHog ----------------------------------------------------------------
# Safe to expose. The project token is public by design.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# --- Search -----------------------------------------------------------------
# SERVER ONLY. The Sanity Context MCP endpoint the search agent queries through.
# The trailing segment is the slug of the `sanity.agentContext` document, which
# supplies the content filter and the query instructions.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/vertex-search

# SERVER ONLY. The model behind search.
OPENAI_API_KEY=

# SERVER ONLY. Spend guards on search (lib/search/quota.ts). Billed searches are
# counted per UTC day; a repeat query served from the 24h cache is free.
# "false" turns search off instantly, before any model call.
SEARCH_ENABLED=true
SEARCH_DAILY_LIMIT_PER_USER=10
SEARCH_DAILY_LIMIT_GLOBAL=100
